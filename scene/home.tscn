text = "EVERY CROSSING COUNTS."
vertical_alignment = 1
horizontal_alignment = 2

[node name="TrafficAnimation" type="AnimationPlayer" parent="Layout"]
libraries = {"": SubResource("animations")}
autoplay = "traffic"

[node name="AudioStreamPlayer" type="AudioStreamPlayer" parent="."]
stream = ExtResource("music")
autoplay = true

[connection signal="pressed" from="Layout/Menu/Button" to="." method="_on_button_pressed"]
